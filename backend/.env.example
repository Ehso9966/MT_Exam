# Sargalay API Configuration
# ----------------------------
# Copy this file to `.env` and fill in your real values.
# DO NOT commit `.env` — it is git-ignored by default.

# Your Sargalay API key (required for "MT AI" / free mode on the server).
# Get one from your Sargalay dashboard.
SARGALAY_API_KEY=

# Sargalay API base URL. Defaults to https://api.sargalay.com/v1
# SARGALAY_BASE_URL=https://api.sargalay.com/v1

# Default model for OCR/vision tasks. Sargalay exposes the DeepSeek V4 vision
# family under this name. Change only if Sargalay renames it.
# SARGALAY_DEFAULT_MODEL=deepseek-v4-flash-vision-exp

# Maximum tokens allowed per image in a chat-completion request.
# The Sargalay spec calls for up to 384 tokens per document image.
# SARGALAY_MAX_TOKENS_PER_IMAGE=384

# Per-request timeout (seconds) for calls to Sargalay.
# SARGALAY_TIMEOUT_SECONDS=120

# Comma-separated list of allowed origins for CORS.
# Use "*" for development. In production, set your frontend domain, e.g.
#   ALLOWED_ORIGINS=https://mt-exam-studio.vercel.app
# ALLOWED_ORIGINS=*

# Maximum request body size in bytes (10 MB default). Used to cap the size
# of base64-encoded images sent by the frontend.
# MAX_REQUEST_BYTES=10485760